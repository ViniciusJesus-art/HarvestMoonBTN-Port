/* @PSX_EXE@ and its overlays, linked in one run as PSYLINK linked them.
 * Generated by cmake/psx.cmake (psx_program) from cmake/program.ld.in and each image's
 * declaration in its CMakeLists.txt: edit those, not this. ld takes the objects in
 * link order, and every wildcard below places its inputs in that order. */

ENTRY(__SN_ENTRY_POINT)

/* The overlays' load regions; the EXE names them (src/main/overlay_regions.c). */
@PSX_REGIONS@
/* The overlays of one region are never loaded together: none references another. */
@PSX_NOCROSSREFS@
SECTIONS
{
@PSX_SECTIONS@/DISCARD/ : { *(*); }
}
