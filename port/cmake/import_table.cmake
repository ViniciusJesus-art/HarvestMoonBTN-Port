# Only members tagged original are resource data. Exclude every built MIPS overlay.
file(STRINGS "${CMAKE_SOURCE_DIR}/disc/a_file.txt" member_lines)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/disc/a_file.txt")
set(import_table "/* Resource names from disc/a_file.txt; no game bytes. */\nstatic const char *const import_members[32]={\n")
set(import_index 0)
foreach(line IN LISTS member_lines)
    if(line MATCHES "^[ \t]*([0-9]+)[ \t]+([^ \t]+)[ \t]+(original|built)[ \t]+")
        if(NOT CMAKE_MATCH_1 EQUAL import_index)
            message(FATAL_ERROR "Unexpected A_FILE member order")
        endif()
        if(CMAKE_MATCH_3 STREQUAL "original")
            string(APPEND import_table "\"${CMAKE_MATCH_2}\",\n")
        else()
            string(APPEND import_table "NULL,\n")
        endif()
        math(EXPR import_index "${import_index}+1")
    endif()
endforeach()
if(NOT import_index EQUAL 32)
    message(FATAL_ERROR "Expected 32 A_FILE members")
endif()
string(APPEND import_table "};\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/import_members.inc" "${import_table}")
