# Runtime-only, explicit install allowlist. No src/sdk/disc/data directories.
if(WIN32)
    enable_language(RC)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/app.rc"
        "101 ICON \"${CMAKE_CURRENT_BINARY_DIR}/generated/hmbtn-native.ico\"\n")
    target_sources(hmbtn_native PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/app.rc")
    set_target_properties(hmbtn_native PROPERTIES WIN32_EXECUTABLE TRUE)
    install(TARGETS hmbtn_native RUNTIME DESTINATION .)
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/generated/hmbtn-native.ico" DESTINATION .)
    install(FILES "${CMAKE_SOURCE_DIR}/docs/port/INSTALLING.txt" DESTINATION . RENAME README.txt)
    if(sdl3_type STREQUAL "SHARED_LIBRARY")
        install(FILES "$<TARGET_FILE:SDL3::SDL3>" DESTINATION .)
    endif()
    set(license_destination licenses)
else()
    install(TARGETS hmbtn_native RUNTIME DESTINATION bin)
    foreach(icon_size 16 24 32 48 64 128 256)
        install(FILES "${CMAKE_CURRENT_BINARY_DIR}/generated/hmbtn-native-${icon_size}.png"
            DESTINATION "share/icons/hicolor/${icon_size}x${icon_size}/apps" RENAME hmbtn-native.png)
    endforeach()
    install(FILES packaging/hmbtn-native.desktop DESTINATION share/applications)
    install(FILES "${CMAKE_SOURCE_DIR}/docs/port/INSTALLING.txt" DESTINATION share/doc/hmbtn-native)
    set(license_destination share/licenses/hmbtn-native)
endif()
install(FILES "${CMAKE_SOURCE_DIR}/LICENSE" DESTINATION "${license_destination}" RENAME CC0.txt)
if(DEFINED SDL3_SOURCE_DIR AND EXISTS "${SDL3_SOURCE_DIR}/LICENSE.txt")
    install(FILES "${SDL3_SOURCE_DIR}/LICENSE.txt" DESTINATION "${license_destination}" RENAME SDL3.txt)
endif()
if(NOT WIN32)
    set(CPACK_PACKAGE_NAME hmbtn-native)
    set(CPACK_PACKAGE_VENDOR "HarvestMoonBTN native port contributors")
    set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
    set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Harvest Moon BTN native PC port (partial)")
    set(CPACK_PACKAGE_DESCRIPTION "Native PC port with built-in disc resource importer. Game resources are not included. The full game is not yet ported.")
    set(CPACK_PACKAGE_CONTACT "HarvestMoonBTN contributors")
    set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
    set(CPACK_PACKAGE_FILE_NAME "HarvestMoonBTN-${PROJECT_VERSION}-linux-x86_64")
    set(CPACK_GENERATOR "DEB;RPM")
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "HarvestMoonBTN contributors")
    set(CPACK_DEBIAN_PACKAGE_SECTION games)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "libx11-6, libxext6, libxcursor1, libxi6, libxfixes3, libxrandr2, libxrender1, libxss1, libxtst6, libudev1, libdbus-1-3, libasound2")
    set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "xdg-desktop-portal")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_RPM_PACKAGE_LICENSE "CC0-1.0 AND Zlib")
    set(CPACK_RPM_PACKAGE_GROUP "Amusements/Games")
    set(CPACK_RPM_PACKAGE_REQUIRES "libX11, libXext, libXcursor, libXi, libXfixes, libXrandr, libXrender, libXScrnSaver, libXtst, systemd-libs, dbus-libs, alsa-lib")
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION "/usr/share/icons" "/usr/share/icons/hicolor" "/usr/share/applications" "/usr/share/licenses")
    foreach(icon_size 16 24 32 48 64 128 256)
        list(APPEND CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION
            "/usr/share/icons/hicolor/${icon_size}x${icon_size}" "/usr/share/icons/hicolor/${icon_size}x${icon_size}/apps")
    endforeach()
    include(CPack)
endif()
